DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=example.com,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
PUBLIC_SITE_ORIGIN=https://example.com
DJANGO_SECURE_COOKIES=true
DJANGO_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false
POSTGRES_DB=nicoption
POSTGRES_USER=nicoption
POSTGRES_PASSWORD=replace-with-a-long-random-value
